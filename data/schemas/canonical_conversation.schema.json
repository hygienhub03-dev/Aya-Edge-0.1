{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aya-edge.local/schemas/canonical_conversation.schema.json",
  "title": "AYA Edge canonical conversation",
  "type": "object",
  "required": ["sample_id", "source_id", "source_revision", "license_id", "category", "messages", "provenance"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["general", "instruction", "agent", "tool_use"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool", "tool_result"]},
          "content": {"type": ["string", "array", "object"]},
          "name": {"type": "string"},
          "tool_call_id": {"type": "string"},
          "tool_calls": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "provenance": {"$ref": "provenance.schema.json"},
    "raw_record": {"type": "object"},
    "token_count": {"type": "integer", "minimum": 0},
    "tokenizer_id": {"type": "string"}
  },
  "additionalProperties": false
}
